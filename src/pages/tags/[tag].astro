---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, getTags, type Post } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return getTags(posts).map(({ tag }) => ({
    params: { tag },
    props: { posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}

interface Props {
  posts: Post[];
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`Posts tagged ${tag}.`}>
  <h1>#{tag}</h1>
  <p class="muted"><a href="/tags/">all tags</a></p>
  <PostList posts={posts} />
</BaseLayout>
